{
  "name": "streamix-tv",
  "version": "1.0.026",
  "description": "Streamix IPTV App for Samsung Smart TV - LightningJS + SolidJS",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "vite --open --host --force",
    "start:prod": "vite --open --host --force --mode production",
    "start:tizen": "TARGET_DEVICE=tizen vite --open --host --force",
    "platform": "node scripts/platform.mjs",
    "build": "vite build --sourcemap=true",
    "build:tizen": "node scripts/platform.mjs build tizen",
    "build:lg": "node scripts/platform.mjs build webos",
    "build:webos": "node scripts/platform.mjs build webos",
    "build:firetv": "node scripts/platform.mjs build firetv",
    "firetv:sync": "node scripts/platform.mjs sync firetv",
    "firetv:apk": "node scripts/platform.mjs apk firetv",
    "firetv:install": "node scripts/platform.mjs install firetv",
    "firetv:deploy": "node scripts/platform.mjs deploy firetv",
    "tizen:package": "node scripts/platform.mjs package tizen",
    "tizen:install": "node scripts/platform.mjs install tizen",
    "tizen:run": "node scripts/platform.mjs run tizen",
    "tizen:kill": "node scripts/platform.mjs kill tizen",
    "tizen:uninstall": "node scripts/platform.mjs uninstall tizen",
    "tizen:install:emu": "node scripts/platform.mjs install tizen emu",
    "tizen:run:emu": "node scripts/platform.mjs run tizen emu",
    "tizen:deploy": "node scripts/platform.mjs deploy tizen",
    "tizen:deploy:emu": "node scripts/platform.mjs deploy tizen emu",
    "webos:package": "node scripts/platform.mjs package webos",
    "tizen:debug": "node scripts/tizen-inspect.js --restart",
    "tizen:inspect": "node scripts/tizen-inspect.js",
    "tizen:inspect:restart": "node scripts/tizen-inspect.js --restart",
    "tizen:logs": "node scripts/tizen-dlog.js",
    "logs": "node scripts/log-server.js",
    "build:analyze": "vite-bundle-visualizer",
    "preview": "vite preview --open --port 8080",
    "test": "vitest",
    "tsc": "tsc",
    "storybook": "STREAMIX_STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STREAMIX_STORYBOOK=true storybook build",
    "prepare": "husky",
    "lint": "eslint '**/*.{js,ts,jsx,tsx}' --format stylish --ignore-pattern 'dist/*' --ignore-pattern 'node_modules'",
    "lint-fix": "eslint '**/*.{js,ts,jsx,tsx}' --fix  --ignore-pattern 'dist/*' --ignore-pattern 'node_modules'",
    "format": "prettier --write '**/*.{js,ts,jsx,tsx,json,md,css,html}' --ignore-path .prettierignore",
    "format:check": "prettier --check '**/*.{js,ts,jsx,tsx,json,md,css,html}' --ignore-path .prettierignore"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^1.0.0",
    "@solidtv/renderer": "^1.8.2",
    "@solidtv/solid": "^1.5.2",
    "hls.js": "^1.7.2",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "^10.0.1",
    "@lightningtv/vite-hex-transform": "^1.1.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitest/browser": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lodash-es": "^4.18.1",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "storybook-solidjs-vite": "^10.7.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-cross-origin-isolation": "^0.1.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "packageManager": "pnpm@9.4.0+sha512.f549b8a52c9d2b8536762f99c0722205efc5af913e77835dbccc3b0b0b2ca9e7dc8022b78062c17291c48e88749c70ce88eb5a74f1fa8c4bf5e18bb46c8bd83a"
}
