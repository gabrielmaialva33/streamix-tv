# Dev-only overrides (loaded by Vite in `development` mode, NOT in production
# builds). Routes API calls through the local Vite proxy (see vite.config.js
# `server.proxy`) so the browser talks same-origin and dodges CORS. The TV/APK
# builds keep using the absolute URLs from .env.
VITE_API_URL=/sx-api/api/v1/catalog
VITE_EPG_URL=/sx-api/api/v1/epg
VITE_HISTORY_URL=/sx-api/api/v1/history
VITE_AUTH_URL=/sx-api/api/v1/auth
VITE_FAVORITES_URL=/sx-api/api/v1/favorites
VITE_SEARCH_URL=/sx-api/api/v1/search
VITE_RECOMMENDATIONS_URL=/sx-api/api/v1/recommendations
VITE_TELEMETRY_URL=/sx-api/api/v1/telemetry

# Silence the log-server WebSocket retries in the browser; use DevTools console.
VITE_ENABLE_DEBUG_OVERLAY=false
