# Streamix TV — env example, copy to `.env` and adjust values
VITE_API_URL=https://streamix.mahina.fun/api/v1/catalog
VITE_EPG_URL=https://streamix.mahina.fun/api/v1/epg
VITE_HISTORY_URL=https://streamix.mahina.fun/api/v1/history
VITE_API_KEY=your_api_key_here

# Host machine IP running the log server (`pnpm logs`). The TV / emulator
# connects via WebSocket here for live debug output.
VITE_LOG_HOST=192.168.1.10

# Debug overlay (set to "false" for production builds to trim bundle).
VITE_ENABLE_DEBUG_OVERLAY=true

# ─── Toolchain (used by scripts/platform.mjs) ──────────────────────────────
# Real Tizen TV target. Port 26101 is appended automatically if missing.
TIZEN_DEVICE_IP=192.168.1.10
# TIZEN_TARGET=192.168.1.10:26101   # overrides TIZEN_DEVICE_IP if set
TIZEN_APP_ID=EI8qhrd7xh.streamix
TIZEN_EMULATOR=T-samsung-10.0-x86_64

# Android / Fire TV build (used by `pnpm firetv:apk`).
JAVA_HOME=/usr/lib/jvm/java-21-openjdk
# ANDROID_HOME=$HOME/Android/Sdk
